+// --- database-level constraints ---------------------------------------------
+
+/**
+ * Direct-store tests.
+ *
+ * The service rejects malformed money and mismatched project/organization
+ * references before it persists anything. These tests call `SqlitePlatformStore`
+ * methods directly, with no service in the path, so they prove the tables enforce
+ * their own invariants instead of relying on the caller having gone through
+ * validation.
+ */
+describe("payment store constraints under direct store access", () => {
+  it("refuses malformed, zero, and over-precision amounts when the service is bypassed", async () => {
+    const harness = await createProposalHarness();
+    const owner = await ownerWithSignedBaseline(harness);
+    const store = harness.platform.store;
+    createConfig(harness, owner);
+    const configRow = store.listPaymentConfigVersions(owner.projectId)[0]!;
+    const obligationRow = store.listPaymentObligationsByVersion(configRow.id)[0]!;
+
+    // Each value is already rejected by the service; each must also be refused
+    // by the columns' own CHECK constraints.
+    const invalidAmounts = [
+      "0",
+      "0.00",
+      ".",
+      "1.2.3",
+      "00.5",
+      "1.",
+      ".5",
+      "1e3",
+      "-10",
+      "+10",
+      "1,500.00",
+      "007",
+      "",
+      "1500.0000000",
+    ];
+    invalidAmounts.forEach((amount, index) => {
+      expectConstraintError(
+        () =>
+          store.createPaymentConfigVersion({
+            ...configRow,
+            id: `invalid-configuration-${index}`,
+            totalAmount: amount,
+          }),
+        /constraint failed/i,
+      );
+      expectConstraintError(
+        () =>
+          store.createPaymentObligation({
+            ...obligationRow,
+            id: `invalid-obligation-${index}`,
+            expectedAmount: amount,
+          }),
+        /constraint failed/i,
+      );
+    });
+
+    // No invalid row survived, and the original records are untouched.
+    assert.equal(store.listPaymentConfigVersions(owner.projectId).length, 1);
+    assert.equal(store.listPaymentObligationsByProject(owner.projectId).length, 1);
+    assert.equal(store.listPaymentConfigVersions(owner.projectId)[0]!.totalAmount, "1500.00");
+    assert.equal(store.listPaymentObligationsByVersion(configRow.id)[0]!.expectedAmount, "1500.00");
+
+    // Representative valid decimal text is still accepted, byte for byte.
+    for (const [index, amount] of ["1500", "1500.50", "120.750"].entries()) {
+      const version = store.createPaymentConfigVersion({
+        ...configRow,
+        id: `valid-configuration-${index}`,
+        versionNumber: 100 + index,
+        totalAmount: amount,
+      });
+      assert.equal(version.totalAmount, amount);
+      const obligation = store.createPaymentObligation({
+        ...obligationRow,
+        id: `valid-obligation-${index}`,
+        paymentConfigVersionId: version.id,
+        orderIndex: 1,
+        expectedAmount: amount,
+      });
+      assert.equal(obligation.expectedAmount, amount);
+    }
+  });
+
+  it("refuses obligations that contradict their configuration's project or organization", async () => {
+    const harness = await createProposalHarness();
+    const first = await ownerWithSignedBaseline(harness);
+
+    // A second project in another organization, with its own completed baseline.
+    const second = await ownerWithProject(harness, OTHER_EMAIL, "Second Synthetic Org");
+    publishFirstVersion(harness, { personId: first.personId, projectId: second.projectId });
+    acceptCurrentProposal(harness, second);
+    createAgreementVersion(harness, first.personId, second.projectId, 1);
+    harness.platform.customerAgreements.sign({
+      personId: second.personId,
+      projectId: second.projectId,
+      versionNumber: 1,
+      actionKey: generateActionKey(),
+    });
+
+    const firstConfig = createConfig(harness, first, {
+      scheduleStructure: "deposit_plus_later",
+      totalAmount: "1500.00",
+      obligations: [
+        { expectedAmount: "500.00", currency: "USD" },
+        { expectedAmount: "1000.00", currency: "USD" },
+      ],
+    }).versions[0]!;
+    const secondConfig = createConfig(harness, second, {
+      personId: first.personId,
+      totalAmount: "500.00",
+      currency: "EUR",
+      obligations: [
+        { expectedAmount: "200.00", currency: "EUR" },
+        { expectedAmount: "300.00", currency: "EUR" },
+      ],
+    }).versions[0]!;
+
+    const store = harness.platform.store;
+    const firstObligation = store.listPaymentObligationsByVersion(firstConfig.id)[0]!;
+    const firstConfigRow = store.listPaymentConfigVersions(first.projectId)[0]!;
+    const firstBefore = store.listPaymentObligationsByProject(first.projectId).length;
+    const secondBefore = store.listPaymentObligationsByProject(second.projectId).length;
+
+    // Accepted: configuration, project, and organization all agree.
+    const accepted = store.createPaymentObligation({
+      ...firstObligation,
+      id: "obligation-correctly-associated",
+      orderIndex: 50,
+    });
+    assert.equal(accepted.paymentConfigVersionId, firstConfig.id);
+    assert.equal(accepted.projectId, first.projectId);
+    assert.equal(accepted.organizationId, first.organizationId);
+
+    // Rejected: the referenced configuration belongs to the other project.
+    expectConstraintError(
+      () =>
+        store.createPaymentObligation({
+          ...firstObligation,
+          id: "obligation-other-projects-configuration",
+          orderIndex: 51,
+          paymentConfigVersionId: secondConfig.id,
+        }),
+      /FOREIGN KEY/i,
+    );
+
+    // Rejected: the organization does not own the project being referenced.
+    expectConstraintError(
+      () =>
+        store.createPaymentObligation({
+          ...firstObligation,
+          id: "obligation-wrong-organization",
+          orderIndex: 52,
+          organizationId: second.organizationId,
+        }),
+      /FOREIGN KEY/i,
+    );
+
+    // Rejected: a configuration cannot claim an organization that does not own
+    // its project either.
+    expectConstraintError(
+      () =>
+        store.createPaymentConfigVersion({
+          ...firstConfigRow,
+          id: "configuration-wrong-organization",
+          versionNumber: 60,
+          organizationId: second.organizationId,
+        }),
+      /FOREIGN KEY/i,
+    );
+
+    // The failed inserts left nothing inconsistent behind.
+    assert.equal(store.listPaymentObligationsByProject(first.projectId).length, firstBefore + 1);
+    assert.equal(store.listPaymentObligationsByProject(second.projectId).length, secondBefore);
+    assert.equal(store.listPaymentObligationsByVersion(firstConfig.id).length, 3);
+    assert.equal(store.listPaymentObligationsByVersion(secondConfig.id).length, 2);
+    assert.equal(store.listPaymentConfigVersions(first.projectId).length, 1);
+    assert.deepEqual(
+      store.listPaymentObligationsByVersion(firstConfig.id).map((row) => row.organizationId),
+      [first.organizationId, first.organizationId, first.organizationId],
+    );
+  });
+
+  it("refuses to open a database whose payment tables predate the strengthened constraints", async () => {
+    const directory = mkdtempSync(join(tmpdir(), "payments-legacy-schema-"));
+    const databasePath = join(directory, "payments.db");
+    try {
+      const first = await createTestPlatform({
+        config: { databasePath, founderEmailHashes: [FOUNDER_HASH] },
+      });
+      const owner = await ownerWithSignedBaseline(first);
+      createConfig(first, owner, {
+        scheduleStructure: "deposit_plus_later",
+        totalAmount: "1500.00",
+        obligations: [
+          { expectedAmount: "500.00", currency: "USD" },
+          { expectedAmount: "1000.00", currency: "USD" },
+        ],
+      });
+      first.platform.close();
+
+      // Rewrite the two tables with the pre-correction definitions, keeping
+      // every row, so this reproduces a database created from the intermediate
+      // revision of the branch.
+      const raw = new DatabaseSync(databasePath);
+      raw.exec("PRAGMA foreign_keys = OFF;");
+      const configRows = raw
+        .prepare("SELECT * FROM payment_config_versions")
+        .all() as Array<Record<string, string | number | null>>;
+      const obligationRows = raw
+        .prepare("SELECT * FROM payment_obligations")
+        .all() as Array<Record<string, string | number | null>>;
+      raw.exec("DROP TABLE payment_obligations; DROP TABLE payment_config_versions;");
+      raw.exec(LEGACY_CONFIG_DDL);
+      raw.exec(LEGACY_OBLIGATION_DDL);
+      for (const [table, rows] of [
+        ["payment_config_versions", configRows],
+        ["payment_obligations", obligationRows],
+      ] as const) {
+        for (const row of rows) {
+          const columns = Object.keys(row);
+          raw
+            .prepare(
+              `INSERT INTO ${table} (${columns.join(", ")}) VALUES (${columns
+                .map(() => "?")
+                .join(", ")})`,
+            )
+            .run(...columns.map((column) => row[column]!));
+        }
+      }
+      raw.close();
+
+      // Opening refuses instead of running on the weaker money and relational
+      // constraints, and it changes nothing.
+      assert.throws(
+        () => new SqlitePlatformStore(databasePath),
+        /created before the payment amount and project\/organization constraints were strengthened/,
+      );
+
+      const verification = new DatabaseSync(databasePath);
+      const versionCount = verification
+        .prepare("SELECT COUNT(*) AS count FROM payment_config_versions")
+        .get() as { count: number };
+      const obligationCount = verification
+        .prepare("SELECT COUNT(*) AS count FROM payment_obligations")
+        .get() as { count: number };
+      assert.equal(versionCount.count, 1);
+      assert.equal(obligationCount.count, 2);
+      verification.close();
+    } finally {
+      rmSync(directory, { recursive: true, force: true });
+    }
+  });
+});
