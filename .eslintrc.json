{
  "root": true,
  "env": {
    "browser": true,
    "node": true,
    "es2021": true
  },
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "module"
  },
  "ignorePatterns": [
    "node_modules/",
    ".next/",
    "**/*.ts",
    "**/*.tsx"
  ],
  "rules": {
    "eqeqeq": ["error", "smart"],
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-new-func": "error",
    "no-script-url": "error",
    "no-throw-literal": "error",
    "no-undef": "error",
    "no-unused-vars": ["warn", { "args": "none" }],
    "no-var": "error",
    "prefer-const": "error"
  }
}
